{
  "name": "m4-control",
  "productName": "Momentum 4 Control",
  "version": "0.4.0",
  "description": "Momentum 4 — GAIA3 SPP control (Electron + Python bridge)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "test:ui": "npm run build && electron tests/status-polling.cjs",
    "test:smoke": "npm run build && electron tests/desktop-smoke.cjs",
    "test:desktop": "node --test tests/bridge-lifecycle.cjs tests/diagnostics.cjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "bridge:build:win": "cd .. && uv run pyinstaller --noconfirm --clean --onedir --name m4-bridge --collect-submodules winrt --distpath build\\bridge\\win --workpath build\\pyinstaller\\win --specpath build bridge.py",
    "bridge:build:mac": "cd .. && uv run pyinstaller --noconfirm --clean --onedir --name m4-bridge --distpath build/bridge/mac --workpath build/pyinstaller/mac --specpath build bridge.py && chmod +x build/bridge/mac/m4-bridge/m4-bridge",
    "bridge:build": "npm run bridge:build:win",
    "dist:win": "npm run bridge:build:win && vite build && electron-builder --win",
    "dist:mac": "npm run bridge:build:mac && vite build && electron-builder --mac",
    "dist": "npm run dist:win"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.munwig.m4control",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "electron/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "../build/bridge/win/m4-bridge/",
          "to": "bridge/win/m4-bridge/"
        }
      ]
    },
    "mac": {
      "icon": "electron/icon-mac.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Momentum 4 Control connects to your Sennheiser MOMENTUM 4 headphones to configure sound settings.",
        "NSBluetoothPeripheralUsageDescription": "Momentum 4 Control connects to your Sennheiser MOMENTUM 4 headphones to configure sound settings."
      },
      "extraResources": [
        {
          "from": "../build/bridge/mac/m4-bridge/",
          "to": "bridge/mac/m4-bridge/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 210,
          "type": "file"
        },
        {
          "x": 400,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
